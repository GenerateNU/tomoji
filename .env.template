# Copy to .env.local and fill in. Never commit .env.local.
# Ask a TL for the WorkOS values; the Convex values come from `bunx convex dev`.

# --- Convex -------------------------------------------------------------
# Written automatically the first time you run `bunx convex dev`.
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# --- WorkOS AuthKit -----------------------------------------------------
# https://dashboard.workos.com -> API Keys
#
# Values are left blank on purpose. Do not commit example values shaped like
# real credentials here — GitHub push protection matches on key prefixes and
# will block the push even for obvious placeholders.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Read by @workos-inc/authkit-nextjs. Get the value from a TL.
WORKOS_CLAIM_TOKEN=

# Must be at least 32 characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=

# Must exactly match a Redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback
