# Copy to .env.local and fill in. Never commit .env.local.

# --- Convex -------------------------------------------------------------
# Written automatically the first time you run `just bd`. These are personal to
# you — each developer gets their own dev deployment. Never copy someone else's.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- WorkOS: ask a TL for these -------------------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_WEBHOOK_SECRET=

# --- WorkOS: generate your own ------------------------------------------
# This is NOT a WorkOS credential. The SDK hands it to iron-session to encrypt
# your local session cookie, so it should be different for every developer.
# Must be at least 32 characters. Generate one (works on any OS) with:
#
#   bun -e 'console.log(crypto.randomUUID()+crypto.randomUUID())'
WORKOS_COOKIE_PASSWORD=

# Must exactly match a Redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback