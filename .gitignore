# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOTE: patterns here are intentionally unanchored (no leading "/") so they
# match at any depth, not just the repo root.
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# npm lockfile — this project uses bun (see packageManager)
package-lock.json

# Keep the template — it documents required vars and holds no real values.
!.env.template

.idea/

