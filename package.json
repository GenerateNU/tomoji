{
  "name": "tomoji",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@workos-inc/authkit-nextjs": "^4.3.1",
    "@workos-inc/node": "^10.13.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "convex": "^1.45.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.58",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.3.9",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
